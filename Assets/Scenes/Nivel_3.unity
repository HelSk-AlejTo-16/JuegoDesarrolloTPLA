MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2017063926}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: adb6bbc5482f4584eb6cddf2736234aa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EnemyEncounterTrigger
  enemies:
  - {fileID: 11400000, guid: 584ea9fe649b5a04a86910d301567d9b, type: 2}
  enemyData: {fileID: 0}
  forceDoubleEncounterGroup: 0
  level2BossController: {fileID: 2017063929}
  mapObjectsToDisableOnWin: []
  battleManager: {fileID: 976475416}
  introDialogueLines:
  - "EL CALACAS: \"Por fin llegan hasta mi despacho subterr\xE1neo... Tumbaste a mis guardias, repartidor. Pero de aqu\xED no saldr\xE1n con vida.\""
  - "INVESTIGADOR PRIVADO: \"Baja las armas, Calacas. Tu imperio clandestino termina hoy. \xA1Entrega la documentaci\xF3n de la red!\""
  - "EL CALACAS: \"\xBFCreen que esa caja es un simple env\xEDo? \xA1Es la verdad que quemar\xE1 toda Santa Felipina! \xA1Vengan si se atreven!\""
  - "VOZ [CORP\xD3REO]: \"\xA1Su postura es \xE1gil! Esquivar\xE1 nuestros golpes directos si no lo acorralamos.\""
  - "VOZ [INTELECTO]: \"\xA1Usa las Bombas de Chile o el Rev\xF3lver de Vargas para romper su manto de sombras y dejarlo vulnerable!\""
  isBossEncounter: 1
  nextSceneName: 00_MenuIntro
  victoryNarrativeLines:
  - "NARRADOR: \"El Calacas cae de rodillas contra las losas h\xFAmedas de su sanctum. Su m\xE1scara y su cuchilla tintinean en el suelo fr\xEDo de la guarida.\""
  - 'EL CALACAS: "(Tosiendo sangre entre la penumbra) Maldito repartidor... No sabes lo que has desatado. Esa caja... no era un paquete de contrabando..."'
  - "DETECTIVE VARGAS: \"(Apuntando con su rev\xF3lver humeante) C\xE1llate, Calacas. Tu red de extorsi\xF3n y tus matones acaban de perder su cabeza.\""
  - "ENRIQUE BOSQUES: \"(Abriendo los sellos de la misteriosa caja) Solo son documentos contables... n\xF3minas del gobierno, expedientes policiales...\""
  - "VOZ [INTELECTO]: \"La prueba definitiva. La mafia y los altos mandos de Santa Felipina estaban en la misma n\xF3mina. El caso est\xE1 cerrado.\""
  - "VOZ [MUNDO INTERNO]: \"El zumbido en tus o\xEDdos disminuye poco a poco. La ciudad sigue all\xE1 arriba, pero las voces por fin descansan en silencio.\""
  - "[ FIN DE LA PARTIDA \u2014 SANTA FELIPINA EN PAZ ]"
  rewardItemOnWin: {fileID: 0}
  rewardItemsOnWin: []
  rewardDialogueLines: []
