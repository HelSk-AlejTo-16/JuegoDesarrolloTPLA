  m_Script: {fileID: 11500000, guid: fb055d1ad16363a4695c17fd00e2f692, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SceneTransitionTrigger
  targetSceneName: 02_Nivel2_Guarida
  triggerOnEnter: 0
  requireBossDefeatedIfPresent: 1
  bossObjectToCheck: {fileID: 2094206573}
  transitionNarrativeLines:
  - "NARRADOR: \"El l\xEDder callejero cae de rodillas sobre el asfalto h\xFAmedo. Entre sus ropas encuentras un croquis manchado que se\xF1ala un estrecho pasaje entre los edificios del centro.\""
  - "ENRIQUE BOSQUES: \"(Guardando el croquis) As\xED que 'El Calacas' est\xE1 detr\xE1s de toda esta trampa... El rastro sigue por ese callej\xF3n.\""
  - "VOZ [INTELECTO]: \"Las calles principales est\xE1n bloqueadas con autos calcinados. Solo existe una ruta hacia su guarida: cruzar a pie por el callej\xF3n entre los edificios.\""
  - "VOZ [MUNDO INTERNO]: \"Entre los muros estrechos alguien m\xE1s sigue el mismo rastro de ceniza y p\xF3lvora. Un investigador privado nos espera bajo la sombra del farol...\""
  - "[ CAP\xCDTULO 2: EL CALLEJ\xD3N DE LAS SOMBRAS ]"
  promptUI: {fileID: 1534948220}
