  m_Script: {fileID: 11500000, guid: adb6bbc5482f4584eb6cddf2736234aa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EnemyEncounterTrigger
  enemies:
  - {fileID: 11400000, guid: a196610e35d92324982685325c800fac, type: 2}
  enemyData: {fileID: 11400000, guid: a196610e35d92324982685325c800fac, type: 2}
  mapObjectsToDisableOnWin:
  - {fileID: 390209060}
  battleManager: {fileID: 1898751684}
  introDialogueLines:
  - 'LACAYO DE EL CALACAS: "Quieto ahi, repartidor! Ese paquete no va a llegar a su destino."'
  - 'ENRIQUE BOSQUES: "Oye tranquilo, solo soy el repartidor... aunque las voces en mi cabeza no opinan igual."'
  - 'VOZ [CORPOREO]: "Miralo bien, Enrique. Es debil. Usa mi boton (CORPOREO) para romperle la guardia de un golpe directo!"'
  - 'VOZ [INTELECTO]: "Si nos topamos con alguien de defensa alta, usa mi boton (INTELECTO) para improvisar un artefacto con chatarra del mapa."'
  - 'VOZ [MOTRICIDAD]: "Somos mas rapidos que el (Motricidad 12 vs 10). Mi boton (MOTRICIDAD) nos prepara para esquivar o reducir el dano un 70%!"'
  - 'VOZ [MUNDO INTERNO]: "Y si quieres que pierda su turno en la cola, usa mi boton (MUNDO INTERNO) para confundir su mente."'
  isBossEncounter: 0
  nextSceneName: 02_Nivel2_Guarida
  victoryNarrativeLines:
  - "El Jefe Callejero cae noqueado contra el pavimento, soltando las llaves del almac\xE9n clandestino..."
  - "ENRIQUE BOSQUES: \"(Limpiando la sangre de sus nudillos) Se acab\xF3. El rastro conduce detr\xE1s de este port\xF3n.\""
  - Las voces en tu mente guardan silencio mientras abres la pesada reja de metal...
  - "[ CAP\xCDTULO 2: LA GUARIDA DE LA MAFIA ]"
  rewardItemOnWin: {fileID: 11400000, guid: a1c48290b3d74e1895210f8c34d6a101, type: 2}
  rewardDialogueLines:
  - "NARRADOR: \"\xA1El lacayo derrotado cae contra el pavimento y suelta una pesada CADENA DE BICICLETA con eslabones de acero engrasado! Enrique la recoge del asfalto.\""
  - "VOZ [CORPOREO]: \"\xA1Nuestra primera arma callejera! Con esta Cadena de Bicicleta (+4 ATQ, +2 Motricidad) nuestros golpes seran mas letales y rapidos.\""
  - "VOZ [INTELECTO]: \"\xA1CADENA DE BICICLETA OBTENIDA Y EQUIPADA! Se ha colocado en tus manos. Puedes abrir el men\xFA [INVENTARIO / TAB] en cualquier momento para ver tu equipamiento, o hacer clic en tu retrato para cambiarla.\""
