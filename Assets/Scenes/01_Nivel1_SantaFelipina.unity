  type: 0
  itemToPickup: {fileID: 11400000, guid: a1c48290b3d74e1895210f8c34d6a102, type: 2}
  quantity: 1
  pickupDialogue:
  - 'NARRADOR: "Un tubo de plomo solido y oxidado, arrancado de las tuberias de drenaje de Santa Felipina."'
  - 'VOZ [CORPOREO]: "Pesa como demonio, pero multiplica la contundencia de nuestro golpe (+6 ATQ). Nadie se levantara de un golpe con esto."'
  - 'VOZ [INTELECTO]: "Pesado pero efectivo. Recuerda entrar a la pestana de Armas para equiparlo en tus manos."'
  triggerAutomaticallyOnEnter: 0
  triggerDialogueOnce: 0
  dialogueLines:
  - 'NARRADOR: "Tocas la puerta oxidada, pero nadie responde desde adentro."'
  - 'VOZ [MUNDO INTERNO]: "Detras de las cortinas alguien nos observa en silencio."'
  promptUI: {fileID: 821826146}
  explorationDialogueManager: {fileID: 1812584857}
