      m_Calls: []
  m_text: "<color=#E5AC24><b>W, A, S, D / Flechas</b></color> : Caminar por las calles de Santa Felipina\n\n<color=#E5AC24><b>Shift</b></color> : Correr a toda velocidad por el pavimento\n\n<color=#E5AC24><b>E / Espacio</b></color> : Interactuar con puertas, personajes y recoger objetos\n\n<color=#E5AC24><b>I / B</b></color> : Abrir la Mochila (Inventario de Objetos y Armas)\n\n<color=#E5AC24><b>Tab / C</b></color> : Consultar y mejorar las 4 Habilidades de Enrique\n\n<color=#E5AC24><b>Esc / P</b></color> : Abrir o cerrar este Men\xFA de Pausa\n\n<color=#E5AC24><b>Clic Izquierdo</b></color> : Seleccionar enemigo en combate y botones de UI"
