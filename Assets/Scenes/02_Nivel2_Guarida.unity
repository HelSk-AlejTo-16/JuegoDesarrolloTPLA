MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1305622015}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3736ee431236e5c41932c4f0a7d7454c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Capitulo2IntroNarrative
  fadeCanvasGroup: {fileID: 1995376552}
  bannerPanel: {fileID: 1238919149}
  chapterTitleText: {fileID: 1263826102}
  chapterSubtitleText: {fileID: 238212061}
  investigatorCompanion: {fileID: 2117043249}
  arrivalDialogueLines:
  - "NARRADOR: \"El paso vehicular termina en una barricada de autos calcinados. Entre las moles de concreto y ladrillo de Santa Felipina solo se abre un laberinto claustrof\xF3bico de callejones donde \xFAnicamente se puede avanzar a pie.\""
  - "VOZ [MUNDO INTERNO]: \"El humo de una colilla reci\xE9n apagada flota en la esquina del primer quiebre. Alguien nos esperaba entre las sombras de estos muros, Enrique.\""
  - "INVESTIGADOR PRIVADO: \"Baja los pu\xF1os, repartidor. Vi c\xF3mo tumbaste a los matones de la avenida... Me llamo H\xE9ctor Vargas, investigador privado.\""
  - "ENRIQUE BOSQUES: \"\xBFUn detective en este basurero? Si vienes por el paquete, llegas tarde. Ni siquiera s\xE9 qu\xE9 demonios llevo dentro.\""
  - "INVESTIGADOR PRIVADO: \"No busco tu caja, Bosques. Busco al jefe que orden\xF3 emboscarte: 'El Calacas'. Llevo meses sigui\xE9ndole el rastro por toda la ciudad.\""
  - 'VOZ [INTELECTO]: "Un investigador privado... Sus expedientes y su conocimiento del terreno nos ahorran caminar a ciegas por este laberinto de callejones. Escucha lo que sabe."'
  - "INVESTIGADOR PRIVADO: \"Estos callejones interiores son el \xFAnico acceso hacia su guarida. Cerraron las calles principales con chatarra para que ninguna patrulla pueda entrar; aqu\xED hay que abrirse paso a pie doblando entre los bloques de edificios.\""
  - "VOZ [CORPOREO]: \"Perfecto. En pasajes as\xED de estrechos no podr\xE1n rodearnos con veh\xEDculos; tendr\xE1n que dar la cara de frente.\""
  - "VOZ [MOTRICIDAD]: \"Cuidado en cada esquina ciega y en los recovecos llenos de botes de basura. Ah\xED es donde emboscan los sicarios.\""
  - "INVESTIGADOR PRIVADO: \"M\xE1s adelante hay varios de sus matones vigilando los pasajes y otro jefe custodiando el port\xF3n del fondo. Me uno a ti, Enrique: yo te sigo, vamos a encontrar a El Calacas.\""
  - "NARRADOR: \"[ EL INVESTIGADOR PRIVADO SE HA UNIDO A TI Y TE SEGUIR\xC1 POR LOS CALLEJONES ]\""
  explorationDialogueManager: {fileID: 1374482746}
