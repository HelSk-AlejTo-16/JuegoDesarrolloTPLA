  - {fileID: 6937817954938267909, guid: e568f61977b034146b7171f95fc23637, type: 3}
  - {fileID: -6470460504253458178, guid: d9c0fa542e46f5941b1a7e317408aea7, type: 3}
  - {fileID: -4178046375966092550, guid: efa3f7c541ce81b4cb0db7506f940b96, type: 3}
  - {fileID: 4130640169021434097, guid: fb5843f72fedbdb43a16750beee1f95d, type: 3}
  - {fileID: 3465286685962602723, guid: 2ccdeeb47a9770b4db7197072e225c03, type: 3}
  - {fileID: 7028616704906629411, guid: 2348cab41af156246a9eddefdb182340, type: 3}
  - {fileID: 8288426215254106694, guid: c45cc912e4fac664485ce9181a057851, type: 3}
  animationFPS: 9
  recruitmentDialogueLines:
  - "NARRADOR: \"El paso vehicular termina en una barricada de autos calcinados y l\xE1minas oxidadas. Entre los edificios altos de Santa Felipina solo queda un estrecho callej\xF3n donde \xFAnicamente se puede avanzar a pie.\""
  - "VOZ [MUNDO INTERNO]: \"El humo de una colilla reci\xE9n apagada flota junto al farol roto. No estamos solos en este callej\xF3n, Enrique.\""
  - "INVESTIGADOR PRIVADO: \"Baja los pu\xF1os, repartidor. Vi c\xF3mo dejaste a los matones de la avenida... Me llamo H\xE9ctor Vargas, investigador privado.\""
  - "ENRIQUE BOSQUES: \"\xBFUn detective en este basurero? Si vienes por el paquete, llegas tarde. Ni siquiera s\xE9 qu\xE9 demonios llevo dentro.\""
  - "INVESTIGADOR PRIVADO: \"No busco tu caja, Bosques. Busco al hombre que orden\xF3 la emboscada: 'El Calacas'. Llevo tres meses sigui\xE9ndole el rastro por toda Santa Felipina.\""
  - 'VOZ [INTELECTO]: "Un investigador privado... Sus expedientes y su conocimiento del terreno nos ahorran caminar a ciegas. Escucha lo que sabe."'
  - "INVESTIGADOR PRIVADO: \"Este callej\xF3n entre los edificios es el \xFAnico acceso a su refugio. Bloquearon las calles con chatarra para que ning\xFAn auto ni patrulla pueda entrar; aqu\xED solo se pasa a pie.\""
  - "VOZ [CORPOREO]: \"M\xE1s vale que sepa repartir golpes si piensa caminar a nuestro lado. El callej\xF3n apesta a emboscada.\""
  - "VOZ [MOTRICIDAD]: \"Se mueve con sigilo y mantiene el paso firme. Nos vendr\xE1 bien alguien que vigile los \xE1ngulos muertos.\""
  - "INVESTIGADOR PRIVADO: \"M\xE1s adelante hay varios de sus sicarios custodiando el paso y su mano derecha protege el fondo del callej\xF3n. Voy contigo, Enrique: te sigo de cerca hasta dar con El Calacas.\""
  - "NARRADOR: \"[ EL INVESTIGADOR PRIVADO SE HA UNIDO A TI Y TE SEGUIR\xC1 POR EL CALLEJ\xD3N ]\""
  followUpDialogueLines:
  - "INVESTIGADOR PRIVADO: \"No bajes la guardia, Bosques. Los techos y las ventanas tapiadas de estos edificios son el nido de los vig\xEDas de El Calacas.\""
  - "VOZ [INTELECTO]: \"Tiene raz\xF3n. El callej\xF3n se estrecha m\xE1s adelante entre los contenedores de basura; revisa cada rinc\xF3n antes de avanzar al fondo.\""
  promptUI: {fileID: 1280642677}
  promptText: {fileID: 1280642678}
