  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: adb6bbc5482f4584eb6cddf2736234aa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EnemyEncounterTrigger
  enemies:
  - {fileID: 11400000, guid: 9073186ba3718934db05fd644bccf6a6, type: 2}
  enemyData: {fileID: 0}
  forceDoubleEncounterGroup: 0
  level2BossController: {fileID: 214904356}
  mapObjectsToDisableOnWin: []
  battleManager: {fileID: 1198574857}
  introDialogueLines:
  - 'LACAYO RAPIDO: "Alto ahi, repartidor! Somos dos contra uno, entrega el paquete del Jefe!"'
  - 'LACAYO FUERTE: "Si no hablas por las buenas, te vamos a moler a golpes entre los dos."'
  - 'VOZ [CORPOREO]: "Dos idiotas frente a nosotros! Haz clic sobre cualquiera de ellos para elegir objetivo y usa mi boton (CORPOREO) para golpear!"'
  - 'VOZ [INTELECTO]: "El grandulon tiene mucha defensa (10). Contra el, usa mi boton (INTELECTO) para improvisar un artefacto e ignorar su armadura."'
  - 'VOZ [MOTRICIDAD]: "Por velocidad actuamos primero nosotros (12), luego el rapido (10) y al final el lento (6). Mi boton (MOTRICIDAD) nos defiende de ambos en esta ronda!"'
  - 'VOZ [MUNDO INTERNO]: "O usa mi boton (MUNDO INTERNO) sobre uno de ellos para confundirlo y que pierda su turno en la cola."'
  isBossEncounter: 1
  nextSceneName: Nivel_3
  victoryNarrativeLines:
  - "NARRADOR: \"El Capataz Punk se desploma derrotado tras el intenso choque de pu\xF1os. La respiraci\xF3n se le corta y cae de rodillas sobre el adoqu\xEDn h\xFAmedo del callej\xF3n.\""
  - "DETECTIVE VARGAS: \"\xA1Gran combate, Bosques! Despachamos al l\xEDder de la banda que vigilaba este acceso. La puerta acorazada del complejo de El Calacas est\xE1 abierta.\""
  - "ENRIQUE BOSQUES: \"Ese desgraciado dijo que El Calacas nos espera en el piso subterr\xE1neo del almac\xE9n... Ya no hay vuelta atr\xE1s.\""
  - "VOZ [INTELECTO]: \"Hemos asegurado el per\xEDmetro exterior y recolectado suministros clave. Nuestro equipo est\xE1 listo para el asalto final.\""
  - "[ CAP\xCDTULO 3: EL COMPLEJO DE EL CALACAS ]"
  rewardItemOnWin: {fileID: 0}
  rewardItemsOnWin: []
  rewardDialogueLines: []
