  portraitContainer: {fileID: 1030222261}
  portraitImage: {fileID: 261720229}
  portraitLabelText: {fileID: 85037060}
  speakerNameText: {fileID: 1701421546}
  enriquePortrait: {fileID: 7353621977714259684, guid: c9dca07927a50e54ebf1342c976aef43, type: 3}
  corporeoPortrait: {fileID: -5521872637349363059, guid: e9a9fa9274edfbe4aa7eee1bd38ab9ee, type: 3}
  intelectoPortrait: {fileID: -4236815467646598101, guid: 94f272e6fb657314f88af75efe0c6812, type: 3}
  motricidadPortrait: {fileID: 5877116541117098598, guid: 1063e020ba18db7418359539b4a1bb06, type: 3}
  mundoInternoPortrait: {fileID: -7323335376597522656, guid: f0c2a04f2d589e347972ff7cb089eb87, type: 3}
  characterGrayColor: {r: 0.5, g: 0.52, b: 0.55, a: 1}
  corporeoColor: {r: 0.82, g: 0.2, b: 0.2, a: 1}
  intelectoColor: {r: 0.2, g: 0.56, b: 0.88, a: 1}
  motricidadColor: {r: 0.88, g: 0.7, b: 0.16, a: 1}
  mundoInternoColor: {r: 0.6, g: 0.26, b: 0.84, a: 1}
  loadSceneOnFinish: 1
  nextSceneName: 01_Nivel1_SantaFelipina
  playerController: {fileID: 0}
  playerMovementScript: {fileID: 0}
  onIntroFinished:
    m_PersistentCalls:
      m_Calls: []
  slides:
  - slidePhoto: {fileID: 21300000, guid: 2ee524b55251a05468ee37563898bb9b, type: 3}
    placeholderColor: {r: 0.82, g: 0.5, b: 0.18, a: 1}
    placeholderPhotoLabel: 'FOTO 1: Calle de Santa Felipina

      Enrique repartiendo en bicicleta'
    speakerType: 0
    characterName: Enrique Bosques
    skillVoice: 0
    customPortraitSprite: {fileID: 0}
    storyText: Santa Felipina hierve bajo el sol y el esmog. Entre callejones empedrados y cables colgantes, Enrique Bosques pedalea a toda velocidad para entregar su ultimo paquete del dia.
  - slidePhoto: {fileID: 21300000, guid: 2ee524b55251a05468ee37563898bb9b, type: 3}
    placeholderColor: {r: 0.82, g: 0.5, b: 0.18, a: 1}
    placeholderPhotoLabel: 'FOTO 1: Calle de Santa Felipina

      Enrique repartiendo en bicicleta'
    speakerType: 1
    characterName: Enrique Bosques
    skillVoice: 0
    customPortraitSprite: {fileID: 7353621977714259684, guid: c9dca07927a50e54ebf1342c976aef43, type: 3}
    storyText: '"Solo una entrega mas en la avenida principal y me voy a dormir... Si esta cadena oxidada aguanta dos cuadras mas."'
  - slidePhoto: {fileID: 21300000, guid: ffcf685881797b24e9f2eca8b66b30f9, type: 3}
    placeholderColor: {r: 0.72, g: 0.18, b: 0.18, a: 1}
    placeholderPhotoLabel: 'FOTO 2: El Accidente

      Caida en bicicleta y golpe en la cabeza'
    speakerType: 0
    characterName: Enrique Bosques
    skillVoice: 0
    customPortraitSprite: {fileID: 0}
    storyText: CRACK! La rueda delantera se hunde en una alcantarilla abierta. Enrique sale disparado por encima del manubrio; su craneo rebota contra el pavimento caliente y todo se funde a negro.
  - slidePhoto: {fileID: 21300000, guid: 549c90b0f4e5f2642bc4da19ef1e7e87, type: 3}
    placeholderColor: {r: 0.28, g: 0.2, b: 0.42, a: 1}
    placeholderPhotoLabel: 'FOTO 3: El Despertar

      Las 4 voces retumbando en la mente de Enrique'
    speakerType: 2
    characterName: Enrique Bosques
    skillVoice: 0
    customPortraitSprite: {fileID: -5521872637349363059, guid: e9a9fa9274edfbe4aa7eee1bd38ab9ee, type: 3}
    storyText: Arriba, pedazo de carne! La sangre aun bombea y los nudillos nos pican. Si alguien se acerca a quitarnos la bici, lo partimos en dos.
  - slidePhoto: {fileID: 21300000, guid: 549c90b0f4e5f2642bc4da19ef1e7e87, type: 3}
    placeholderColor: {r: 0.28, g: 0.2, b: 0.42, a: 1}
    placeholderPhotoLabel: 'FOTO 3: El Despertar

      Las 4 voces retumbando en la mente de Enrique'
    speakerType: 2
    characterName: Enrique Bosques
    skillVoice: 1
    customPortraitSprite: {fileID: -4236815467646598101, guid: 94f272e6fb657314f88af75efe0c6812, type: 3}
    storyText: 'Fascinante. El golpe dividio nuestra mente en cuatro. Observa el suelo: tuercas, botellas rotas, cables... podemos improvisar objetos utiles con todo esto.'
  - slidePhoto: {fileID: 21300000, guid: 549c90b0f4e5f2642bc4da19ef1e7e87, type: 3}
    placeholderColor: {r: 0.28, g: 0.2, b: 0.42, a: 1}
    placeholderPhotoLabel: 'FOTO 3: El Despertar

      Las 4 voces retumbando en la mente de Enrique'
    speakerType: 2
    characterName: Enrique Bosques
    skillVoice: 2
    customPortraitSprite: {fileID: 5877116541117098598, guid: 1063e020ba18db7418359539b4a1bb06, type: 3}
    storyText: 'Callense y miren los pies! El equilibrio vuelve. Somos rapidos: nosotros decidimos quien actua primero y cuando esquivar o defender.'
  - slidePhoto: {fileID: 21300000, guid: 549c90b0f4e5f2642bc4da19ef1e7e87, type: 3}
    placeholderColor: {r: 0.28, g: 0.2, b: 0.42, a: 1}
    placeholderPhotoLabel: 'FOTO 3: El Despertar

      Las 4 voces retumbando en la mente de Enrique'
    speakerType: 2
    characterName: Enrique Bosques
    skillVoice: 3
    customPortraitSprite: {fileID: -7323335376597522656, guid: f0c2a04f2d589e347972ff7cb089eb87, type: 3}
    storyText: Las farolas de Santa Felipina nos observan en silencio... Si proyectamos este delirio hacia nuestros enemigos, confundiremos sus mentes y alteraremos su animo.
  - slidePhoto: {fileID: 21300000, guid: 549c90b0f4e5f2642bc4da19ef1e7e87, type: 3}
    placeholderColor: {r: 0.18, g: 0.42, b: 0.38, a: 1}
    placeholderPhotoLabel: 'FOTO 4: La Entrega Equivocada

      El paquete del mafioso perdido'
    speakerType: 1
    characterName: Enrique Bosques
    skillVoice: 0
    customPortraitSprite: {fileID: 7353621977714259684, guid: c9dca07927a50e54ebf1342c976aef43, type: 3}
    storyText: '"Quienes estan gritando en mi cabeza?... Espera. Mi mochila esta abierta. Entregue el paquete equivocado... El encargo privado del mafioso no esta!"'
  - slidePhoto: {fileID: 21300000, guid: 549c90b0f4e5f2642bc4da19ef1e7e87, type: 3}
    placeholderColor: {r: 0.18, g: 0.42, b: 0.38, a: 1}
    placeholderPhotoLabel: 'FOTO 4: La Entrega Equivocada

      El paquete del mafioso perdido'
    speakerType: 1
    characterName: Lacayo de la Mafia
    skillVoice: 0
    customPortraitSprite: {fileID: 0}
    storyText: '"Ahi esta el repartidor de la bicicleta! No dejen que se escape sin devolver el paquete del Jefe!"'
