      m_Calls: []
  m_text: '<color=#E2E4EB><b>DIRECCION & DESARROLLO DE VIDEOJUEGO</b></color>

    <color=#A0A3AB>Equipo de Desarrollo de RPG Santa Felipina</color>


    <color=#E2E4EB><b>UNIVERSO NARRATIVO Y PSICOLOGIA DE PERSONAJES</b></color>

    <color=#A0A3AB>Inspirado en la psique fragmentada de Enrique Bosques y sus 4 Voces:

    <color=#D83A3A>Corporeo</color>  -  <color=#3399E8>Intelecto</color>  -  <color=#E5AC24>Motricidad</color>  -  <color=#A045E6>Mundo Interno</color></color>


    <color=#E2E4EB><b>BANDA SONORA Y MUSICA ORIGINAL</b></color>

    <color=#A0A3AB>Chill Menu Loopable  -  Crashing Out Loopable  -  Critical Theme Loopable

    VictoryLap Loopable  -  80s Zombies Movie (Clement Panchout)</color>


    <color=#E2E4EB><b>DISENO SONORO Y EFECTOS ACUSTICOS</b></color>

    <color=#A0A3AB>Pixel UI SFX Pack (JDSherbert)  -  Efectos de Impacto, Habilidades y Pasos</color>


    <color=#E2E4EB><b>ARTE 2D, RETRATOS & ESCENARIOS</b></color>

    <color=#A0A3AB>PostApocalypse 2D Asset Pack  -  Ilustraciones y Retratos Originales</color>


    <color=#E5AC24><b>GRACIAS POR EMBARCARTE EN ESTA AVENTURA!</b></color>'
